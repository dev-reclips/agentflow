NEXT_PUBLIC_API_URL=http://localhost:3001

# Formspree form ID for static-export email capture (GitHub Pages)
# Get from formspree.io — create a free account and copy the form ID
# On GitHub Pages: add FORMSPREE_FORM_ID to repo Settings -> Secrets -> Actions
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Demo environment — expose demo password to browser for /demo auto-login
# Only set this in demo/staging environments, never production
NEXT_PUBLIC_DEMO_PASSWORD=
